SUPABASE_PROJECT_REF=ref
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321/
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=publishable_key

# Solana records (devnet). Without SOLANA_SERVICE_KEY nothing is recorded.
# The service key pays the fees: a solana-keygen JSON byte array, funded with
# devnet SOL from https://faucet.solana.com. SUPABASE_SECRET_KEY lets the
# server write the records.
SUPABASE_SECRET_KEY=
SOLANA_SERVICE_KEY=
# SOLANA_RPC_URL=https://api.devnet.solana.com
